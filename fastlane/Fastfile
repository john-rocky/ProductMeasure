default_platform(:ios)

API_KEY_ID = "DQK2VMHWM9"
API_ISSUER_ID = "69a6de96-8f3e-47e3-e053-5b8c7c11a4d1"
API_KEY_PATH = File.expand_path("../../AuthKey_DQK2VMHWM9.p8", __dir__)

platform :ios do

  desc "Build and upload to App Store Connect for review"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: API_KEY_ID,
      issuer_id: API_ISSUER_ID,
      key_filepath: API_KEY_PATH
    )

    increment_build_number(
      build_number: (latest_testflight_build_number(api_key: api_key) rescue 0) + 1
    )

    build_app(
      scheme: "ProductMeasure",
      export_method: "app-store",
      export_options: {
        signingStyle: "automatic",
        teamID: "MFN25KNUGJ"
      },
      xcargs: "-allowProvisioningUpdates -authenticationKeyPath '#{API_KEY_PATH}' -authenticationKeyID '#{API_KEY_ID}' -authenticationKeyIssuerID '#{API_ISSUER_ID}'"
    )

    upload_to_app_store(
      api_key: api_key,
      skip_screenshots: true,
      skip_metadata: false,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Build and upload to TestFlight only"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: API_KEY_ID,
      issuer_id: API_ISSUER_ID,
      key_filepath: API_KEY_PATH
    )

    increment_build_number(
      build_number: (latest_testflight_build_number(api_key: api_key) rescue 0) + 1
    )

    build_app(
      scheme: "ProductMeasure",
      export_method: "app-store",
      export_options: {
        signingStyle: "automatic",
        teamID: "MFN25KNUGJ"
      },
      xcargs: "-allowProvisioningUpdates -authenticationKeyPath '#{API_KEY_PATH}' -authenticationKeyID '#{API_KEY_ID}' -authenticationKeyIssuerID '#{API_ISSUER_ID}'"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

end
