    "This app requires a device with a LiDAR sensor for accurate 3D measurements. Please use an iPhone Pro or iPad Pro with LiDAR.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正確な3D計測にはLiDARセンサー搭載デバイスが必要です。iPhone ProまたはLiDAR搭載のiPad Proをご使用ください。"
          }
        }
      }
    },
    "tip.avoid.above.desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Poor height estimation without side faces"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "側面がなく高さの推定精度が低い"
          }
        }
      }
    },
    "tip.avoid.above.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Directly Above"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "真上から"
          }
        }
      }
    },
    "tip.avoid.distance.desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay within 20cm-2m range for small objects"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さい物体は20cm〜2mの範囲内で"
          }
        }
      }
    },
    "tip.avoid.distance.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Distance Limits"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "距離の制限"
          }
        }
      }
    },
    "tip.avoid.moving.desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point density drops with excessive movement between taps"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップ間の移動が大きいと点群密度が低下"
          }
        }
      }
    },
    "tip.avoid.moving.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving Too Far"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きく動く"
          }
        }
      }
    },
    "tip.avoid.opposite.desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May fail the 30% overlap check"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30%の重複検証に失敗する可能性がある"
          }
        }
      }
    },
    "tip.avoid.opposite.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opposite Side (180°)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "真反対側 (180°)"
          }
        }
      }
    },
    "tip.avoid.sameangle.desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No new point cloud data if both taps are identical"
          }
