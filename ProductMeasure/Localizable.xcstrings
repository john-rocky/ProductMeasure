            "value" : "基本的なスキャンのコツ"
          }
        }
      }
    },
    "tip.section.twotap" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two-Tap Strategy"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2タップ戦略"
          }
        }
      }
    },
    "tip.section.avoid" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What to Avoid"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "避けるべきこと"
          }
        }
      }
    },
    "tip.general.angle.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimal Angle"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最適な角度"
          }
        }
      }
    },
    "tip.general.angle.desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold device at 15-30° downward from horizontal"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水平から15〜30°下向きに端末を構える"
          }
        }
      }
    },
    "tip.general.distance.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep Distance"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "距離を保つ"
          }
        }
      }
    },
    "tip.general.distance.desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stay 30-60cm from the object"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対象から30〜60cmの距離を保つ"
          }
        }
      }
    },
    "tip.general.steady.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold Steady"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "静止する"
          }
        }
      }
    },
    "tip.general.steady.desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wait 2-3 seconds before tapping for depth accumulation"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タップ前に2〜3秒静止して深度を蓄積"
          }
        }
      }
    },
    "tip.general.face.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face Surfaces"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面に正対する"
          }
        }
      }
    },
    "tip.general.face.desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep 0-30° angle of incidence to surfaces for best accuracy"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面への入射角を0〜30°に保つと精度が高い"
          }
        }
      }
    },
    "tip.general.steep.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoid Steep Angles"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "急角度を避ける"
          }
        }
      }
    },
    "tip.general.steep.desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angles over 60° significantly reduce depth confidence"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "60°以上の角度は深度の信頼性が大きく低下する"
          }
        }
      }
    },
    "tip.twotap.first.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First Tap"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1回目のタップ"
          }
        }
      }
    },
    "tip.twotap.first.desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capture front + top faces from front, slightly above"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正面やや上から前面＋上面を捉える"
          }
        }
      }
    },
    "tip.twotap.second.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Second Tap"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2回目のタップ"
          }
        }
      }
    },
    "tip.twotap.second.desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move 60-90° around the object to capture side + top"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "60〜90°横に回り込み側面＋上面を捉える"
          }
        }
      }
    },
    "tip.twotap.sameangle.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Same Vertical Angle"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ垂直角度"
          }
        }
      }
    },
    "tip.twotap.sameangle.desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the same 15-30° downward angle for both taps"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両タップとも15〜30°の見下ろし角度を維持"
          }
        }
      }
    },
    "tip.twotap.samedist.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Same Distance"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ距離"
          }
        }
      }
    },
    "tip.twotap.samedist.desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintain the same distance for consistent point density"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ距離を保ち点群密度を一定に"
          }
        }
      }
    },
    "tip.twotap.overlap.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top Face Overlap"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上面の重なり"
          }
        }
      }
    },
    "tip.twotap.overlap.desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top face visible in both taps ensures overlap validation passes"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両タップで上面が見えることで重複検証をクリア"
          }
        }
      }
    },
    "tip.avoid.sameangle.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Same Angle Twice"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ角度で2回"
          }
        }
      }
    },
    "tip.avoid.sameangle.desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No new point cloud data if both taps are identical"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ角度では新しい点群が得られない"
          }
        }
      }
    },
    "tip.avoid.opposite.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opposite Side (180°)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "真反対側 (180°)"
          }
        }
      }
    },
    "tip.avoid.opposite.desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "May fail the 30% overlap check"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30%の重複検証に失敗する可能性がある"
          }
        }
      }
    },
    "tip.avoid.above.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Directly Above"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "真上から"
          }
        }
      }
    },
    "tip.avoid.above.desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poor height estimation without side faces"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "側面がなく高さの推定精度が低い"
          }
        }
      }
    },
    "tip.avoid.moving.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moving Too Far"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大きく動く"
          }
        }
      }
    },
    "tip.avoid.moving.desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Point density drops with excessive movement between taps"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タップ間の移動が大きいと点群密度が低下"
          }
        }
      }
    },
    "tip.avoid.surface.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bad Surfaces"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "悪い表面"
          }
        }
      }
    },
    "tip.avoid.surface.desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transparent or reflective surfaces cause poor depth"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透明・反射面は深度精度を低下させる"
          }
        }
      }
    },
    "tip.avoid.distance.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distance Limits"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "距離の制限"
          }
        }
      }
    },
    "tip.avoid.distance.desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stay within 20cm-2m range for small objects"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小さい物体は20cm〜2mの範囲内で"
          }
        }
      }
    },
    "setting.showScanningTips" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show Scanning Tips Button"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキャンのコツボタンを表示"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
