    "This app requires a device with a LiDAR sensor for accurate 3D measurements. Please use an iPhone Pro or iPad Pro with LiDAR." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正確な3D計測にはLiDARセンサー搭載デバイスが必要です。iPhone ProまたはLiDAR搭載のiPad Proをご使用ください。"
          }
        }
      }
    },
    "tip.avoid.above.desc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
